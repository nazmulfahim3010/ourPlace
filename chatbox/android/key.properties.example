# Production Keystore Configuration Template for Nest
# Copy this file to `android/key.properties` and populate with real signing credentials
# WARNING: NEVER commit `key.properties` or `*.jks` keystore files to source control!

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=../app/nest-release-key.jks
